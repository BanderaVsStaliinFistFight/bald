# Window for the Astartes tech folder (sm_astartes_folder).
# The tech screen finds a folder's window by the folder's name. Each technology tree
# is laid out inside a gridbox named <root technology>_tree, and tech positions are
# slots of that grid. The Astartes techs form one tree rooted at sm_geneseed_sequencing.

guiTypes = {
	containerWindowType = {
		name = "sm_astartes_folder"
		position = { x = 0 y = 0 }
		size = { width = 100%% height = 100%% }
		clipping = yes
		drag_scroll = { left middle }
		verticalScrollbar = "right_vertical_slider"
		horizontalScrollbar = "bottom_horizontal_slider"
		scroll_wheel_factor = 40
		smooth_scrolling = yes

		gridboxtype = {
			name = "sm_geneseed_sequencing_tree"
			position = { x = 40 y = 30 }
			size = { width = 1540 height = 1150 }
			slotsize = { width = 70 height = 70 }
			format = "UPPER_LEFT"
		}
	}
}
